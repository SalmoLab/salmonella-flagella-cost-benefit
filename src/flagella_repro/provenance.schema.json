{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/flagella-repro/provenance.schema.json",
  "title": "Flagella manuscript panel provenance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "panel_id",
    "status",
    "generated_at_utc",
    "command",
    "inputs",
    "outputs",
    "software",
    "parameters",
    "random_seeds"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "panel_id": {"type": "string", "pattern": "^(F[1-7]|S[1-5])_[A-L]$"},
    "status": {
      "enum": [
        "reproduced",
        "partial_reproduction",
        "blocked_external",
        "blocked_asset",
        "failed"
      ]
    },
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"$ref": "#/$defs/artifacts"},
    "outputs": {"$ref": "#/$defs/artifacts"},
    "software": {"type": "object"},
    "parameters": {"type": "object"},
    "random_seeds": {"type": "object"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "blocker": {
      "type": "object",
      "required": ["reason", "required_assets"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "required_assets": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "rows": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked_external"}}},
      "then": {"required": ["blocker"]}
    },
    {
      "if": {"properties": {"status": {"const": "blocked_asset"}}},
      "then": {"required": ["blocker"]}
    },
    {
      "if": {"properties": {"status": {"const": "reproduced"}}},
      "then": {"properties": {"outputs": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "partial_reproduction"}}},
      "then": {
        "required": ["limitations"],
        "properties": {"outputs": {"minItems": 1}}
      }
    }
  ]
}
