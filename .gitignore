# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.snakemake/

# macOS
.DS_Store
*" 2".*
* 2/

# Agent scratch and git worktrees. Two stray gitlinks under .claude/worktrees/
# were tracked by mistake; this rule stops them coming back. Removing the
# existing index entries needs `git rm --cached` as well.
.claude/

# Regenerable build outputs (163 MB). Every figure, panel, statistic and
# Source Data table here is reproduced by `make reproduce-available`.
/build/

# Large static inputs and frozen baselines, versioned outside git.
# These are NOT regenerable; they are backed up separately and are read-only
# for the build. `data/` is published as a Zenodo deposit; see README.md.
#
# The leading slash matters. Without it, `data/` also matched
# `models/motility_simulation/upstream/data/`, so a clone lost the vendored
# simulation's own `config.yml` and `motility_summary_parameters.csv`, and
# Supplementary Figures 4 and 5 could not build from a clone. The upstream
# `CHECKSUMS.sha256` lists both files, so the tree was incomplete against its
# own record. Anchored on 15 August 2026.
/data/
/reference/
/archive/
